        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.lvel9815.MiInventario",
      
      "usesCleartextTraffic": true,
      "permissions": ["INTERNET"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3353523c-e900-42f9-acbc-2dcf951f440a"
      }
    }
  }
}
